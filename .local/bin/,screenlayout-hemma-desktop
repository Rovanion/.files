#!/bin/sh
case $(hostname) in
	T14i)
		xrandr \
			--output eDP-1 --mode 1920x1200 --pos 320x1440 --rotate normal \
			--output HDMI-1 --mode 2560x1440 --pos 0x0 --rotate normal \
			--output DP-1 --off \
			--output DP-2 --off ;;
		;;
	T14)
		xrandr \
			--output eDP --primary --mode 1920x1200 --pos 320x1440 --rotate normal \
			--output HDMI-A-0 --mode 2560x1440 --pos 0x0 --rotate normal \
			--output DisplayPort-0 --off \
			--output DisplayPort-1 --off \
			--output DisplayPort-2 --off \
			--output DisplayPort-3 --off \
			--output DisplayPort-4 --off \
			--output DisplayPort-5 --off ;;
	*)
		echo "Unsupported host $(hostname)."
		exit 1 ;;
esac
